# Copy values into backend/.env for local development. Never commit real secrets.
DATABASE_URL=mysql+pymysql://tarot_user:change_me@127.0.0.1:3307/tarot_reading?charset=utf8mb4
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
AUTH_ATTEMPT_LIMIT=10
AUTH_WINDOW_SECONDS=900
GUEST_READING_RETENTION_DAYS=30
AI_PROVIDER=disabled
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-6.1-terra
# For Gemini, set AI_MODEL=gemini-3.5-flash-lite and GEMINI_API_KEY above.
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=6000
AI_DAILY_REQUEST_LIMIT=100
AI_ACCOUNT_DAILY_REQUEST_LIMIT=20
AI_GUEST_IP_DAILY_REQUEST_LIMIT=10
# Set both rates to estimate costs for a different model.
# AI_INPUT_USD_PER_MILLION=1.00
# AI_OUTPUT_USD_PER_MILLION=5.00
REVERSED_CARDS_ENABLED=false
